  author = {Ray, Aniruddha and Khalid, Muhammad Arslan and Dem{\v c}enko, Andriejus and Daloglu, Mustafa and Tseng, Derek and Reboud, Julien and Cooper, Jonathan M. and Ozcan, Aydogan},
