@article{Lemke2025PhysicsInformedIdentificationInterpolation,
  title = {Physics-{{Informed Identification}} and {{Interpolation}} of the {{Directivity}} of {{Sound Sources}}},
  author = {Lemke, Mathias and H{\"o}lter, Arne and Weinzierl, Stefan},
  year = {2025},
