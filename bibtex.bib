@inproceedings{Jin2013MultizoneSoundfieldReproduction,
  title = {Multizone Soundfield Reproduction Using Orthogonal Basis Expansion},
  booktitle = {2013 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}}},
  author = {Jin, Wenyu and Kleijn, W. Bastiaan and Virette, David},
  year = {2013},
