@article{Rotter2009NonHermitianHamiltonOperator,
  title = {A Non-{{Hermitian Hamilton}} Operator and the Physics of Open Quantum Systems},
  author = {Rotter, Ingrid},
  year = {2009},
  month = mar,
  journal = {J. Phys. A: Math. Theor.},
  volume = {42},
  number = {15},
