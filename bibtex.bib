@article{Jiang2019UltrasoundInducedWirelessEnergy,
  title = {Ultrasound-{{Induced Wireless Energy Harvesting}} for {{Potential Retinal Electrical Stimulation Application}}},
  author = {Jiang, Laiming and Yang, Yang and Chen, Ruimin and Lu, Gengxi and Li, Runze and Xing, Jie and Shung, K. Kirk and Humayun, Mark S. and Zhu, Jianguo and Chen, Yong and Zhou, Qifa},
  year = {2019},
  journal = {Advanced Functional Materials},
