@inproceedings{Arnela2020ExponentialSineSweeps,
  title = {Exponential Sine Sweeps to Measure the Diretivity of an Omnidirectional Parametric Loudspeaker},
  booktitle = {Forum {{Acusticum}} 2020},
  author = {Arnela, Marc and {Martinez-Suquia}, Carme and Guasch, Oriol},
  year = {2020},
  pages = {4},
  abstract = {Omnidirectional sound sources are needed in many room acoustics tests such as the measurement of the reverberation time or the airborne sound insulation. Drivers are typically set on the faces of a dodecahedron to generate an omnidirectional sound field. However, drivers become more directional as frequency increases, which causes a loss of omnidirectionality, especially in the vicinity of the dodecahedron edges. Several alternative devices have been proposed to remedy this problem. One of them, the Omnidirectional Parametric Loudspeaker (OPL), relies on the well-known parametric acoustic array (PAA) phenomenon. An OPL is made of hundreds of small ultrasound transducers set on a sphere. Each piezoelectric transducer emits a narrow collimated beam consisting of an ultrasonic carrier with an amplitude modulated signal. Thanks to non-linear propagation effects, the air itself demodulates the signal bringing it back to the audible range. As a result, a very omnidirectional sound field can be generated by an OPL, especially at high frequencies, since the density of transducers is very high.},
  langid = {english},
  keywords = {omnidirectional PAL}
}

