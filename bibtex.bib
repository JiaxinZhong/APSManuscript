@article{Prince2023NanocolloidalHydrogelMimics,
  title = {Nanocolloidal Hydrogel Mimics the Structure and Nonlinear Mechanical Properties of Biological Fibrous Networks},
  author = {Prince, Elisabeth and Morozova, Sofia and Chen, Zhengkun and Adibnia, Vahid and Yakavets, Ilya and Panyukov, Sergey and Rubinstein, Michael and Kumacheva, Eugenia},
