@article{Solovchuk2013SimulationNonlinearWestervelt,
  title = {Simulation of Nonlinear {{Westervelt}} Equation for the Investigation of Acoustic Streaming and Nonlinear Propagation Effects},
  author = {Solovchuk, Maxim and Sheu, Tony W. H. and Thiriet, Marc},
