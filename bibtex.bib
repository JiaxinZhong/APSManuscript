@misc{Moseley2020SolvingWaveEquation,
  title = {Solving the Wave Equation with Physics-Informed Deep Learning},
  author = {Moseley, Ben and Markham, Andrew and {Nissen-Meyer}, Tarje},
  year = {2020},
