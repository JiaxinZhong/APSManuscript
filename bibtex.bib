@article{Rafi-Ul-Islam2024TwistedTopologyNonHermitian,
  title = {Twisted Topology of Non-{{Hermitian}} Systems Induced by Long-Range Coupling},
  author = {{Rafi-Ul-Islam}, S. M. and Siu, Zhuo Bin and Sahin, Haydar and Razo, Md. Saddam Hossain and Jalil, Mansoor B. A.},
  year = {2024},
  month = jan,
  journal = {Phys. Rev. B},
