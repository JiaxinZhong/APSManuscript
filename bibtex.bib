  urldate = {2024-12-15},
  abstract = {The interplay between the non-Hermiticity and dimensionality gives rise to exotic characteristics in higher dimensions, with one representative phenomenon known as the geometry-dependent skin effect (GDSE), which refers to that the localization of extensive eigenstates depends on the system's geometry under open boundary conditions. In this paper, we demonstrate the emergence of GDSE in a two-dimensional {$s$}⁢{$p$} optical ladder lattice with on-site atom loss, which can be manifested by anisotropic dynamics of Bloch oscillations in the bulk of the system. By applying a static force in different directions, the wave-packet dynamics retrieves the complex energy spectra with either nonzero or zero spectral winding number, indicating the presence or absence of skin accumulation in the corresponding directions, respectively. We find that this bulk dynamical characterization can be extended to interacting multiparticle systems, offering a method for detecting GDSE and other types of skin effect in quantum many-body systems, even without a well-defined open boundary.},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\FS28GL8Z\\Qin et al. - 2024 - Geometry-dependent skin effect and anisotropic Bloch oscillations in a non-Hermitian optical lattice.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\4IPBXXNS\\PhysRevA.109.html}
}

@article{Qin2025DisorderassistedRealMomentum,
