@article{Xiao2019EnhancedSensingNondegraded,
  title = {Enhanced {{Sensing}} and {{Nondegraded Thermal Noise Performance Based}} on \${\textbackslash}mathcal\{\vphantom\}{{P}}\vphantom\{\}{\textbackslash}mathcal\{\vphantom\}{{T}}\vphantom\{\}\$-{{Symmetric Electronic Circuits}} with a {{Sixth-Order Exceptional Point}}},
