@article{Xie2021HigherorderBandTopology,
  title = {Higher-Order Band Topology},
  author = {Xie, Biye and Wang, Hai-Xiao and Zhang, Xiujuan and Zhan, Peng and Jiang, Jian-Hua and Lu, Minghui and Chen, Yanfeng},
  year = {2021},
  month = jul,
  journal = {Nat Rev Phys},
  volume = {3},
  number = {7},
  pages = {520--532},
  publisher = {Nature Publishing Group},
  issn = {2522-5820},
  doi = {10.1038/s42254-021-00323-4},
  urldate = {2023-07-26},
  abstract = {A conventional topological insulator (TI) has gapped bulk states but gapless edge states. The emergence of the gapless edge states is dictated by the bulk topological invariant of the insulator and the preservation of relevant symmetries. Over the past four years, a new type of TI has been found, which hosts gapless hinge or corner states, rather than edge states. These unconventional TIs, termed higher-order TIs (HOTIs), are common among crystalline and quasi-crystalline materials. Higher-order band topology expands our previous understanding of topological phases and provides unprecedented lower-dimensional boundary states for devices. Here, we review the principles, theories and experimental realizations of HOTIs for both electrons and classical waves. There is an emphasis on the development of HOTIs in photonic, phononic and circuit systems owing to their special contributions to these fields. From these discussions, we remark on trends and challenges in the field and the impact of higher-order band topology on other scientific disciplines.},
  copyright = {2021 Springer Nature Limited},
  langid = {english},
  keywords = {Photonic crystals,Topological insulators}
}

@article{Xie2022PhotonicTopologicalPump,
  title = {Photonic Topological Pump between Chiral Disclination States},
