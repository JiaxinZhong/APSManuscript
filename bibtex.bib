@article{Lengert2022OptoacousticTonesGenerated,
  title = {Optoacoustic Tones Generated by Nanosecond Laser Pulses Can Cover the Entire Human Hearing Range},
  author = {Lengert, Liza and Lohmann, Hinnerk and Johannsmeier, Sonja and Ripken, Tammo and Maier, Hannes and Heisterkamp, Alexander and Kalies, Stefan},
