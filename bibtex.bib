  issn = {0003-682X},
  doi = {10.1016/j.apacoust.2025.110670},
  urldate = {2025-03-18},
  abstract = {Personal sound zones allow people in different zones to listen to different audio programs without using headphones. It is proposed in this paper to use the active noise control (ANC) method to create bright and dark zones in car cabins with headrest loudspeakers, and its performance is compared with the most commonly used pressure matching (PM) method. Numerical simulations based on a finite element model of a car cabin show that the ANC method can achieve similar acoustic contrast control performance to that with the PM method with fewer channels, and the adaptive algorithm has the potential to be applied in the system. The experiment results obtained in a mid-trim level A-class sedan are presented to support the findings in the simulations, and subjective experiments are carried out to evaluate the performance of these two methods.},
  keywords = {Acoustic contrast control,Active noise control,Car cabin,Pressure matching},
