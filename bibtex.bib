}

@article{Guo2024NonlinearFieldsFocused,
  title = {Nonlinear Fields of Focused Acoustic-Vortex Beams},
  author = {Guo, Ge-pu and Li, Xiao-fei and Chen, Zhen-hua and Meng, Ting-hui and Li, Yu-zhi and Ma, Qing-yu},
  year = {2024},
