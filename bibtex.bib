  journal = {Phys. Rev. Appl.},
  volume = {21},
  number = {3},
  pages = {034043},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevApplied.21.034043},
  urldate = {2024-03-25},
  abstract = {Extended states are usually in the continuum spectrum. Recent studies revealed that the extended states can be isolated in the band gap, which has not yet been confirmed in electric circuits. In this work, based on the non-Hermitian Su-Schrieffer-Heeger electric circuits, we realize the extended states that are isolated in the band gap, which can be attributed to the non-Hermitian skin effect. In particular, these extended states are topological with the quantized topological invariants. The non-Hermitian skin effect and topological extended states are confirmed directly by the measured voltage responses. We further show the extended states are robust against weak disorders. Our system provides a tunable platform to explore alternative phenomena arising from the isolated topological extended states.},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\5EZIEQQJ\\Lu et al_2024_Extended states isolated in the band gap in non-Hermitian electrical circuits.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\8N3AT9I7\\PhysRevApplied.21.html}
}

@article{Lu2024ModeMatchingApproachAcoustic,
  title = {A {{Mode-Matching Approach}} for {{Acoustic Vortex Generation}} in {{Circular Array Configurations}}},
  author = {Lu, Zekai and Wang, Jiale and Lian, Jie and Wang, Yingmin},
  year = {2024},
  journal = {IEEE Signal Processing Letters},
  volume = {31},
  pages = {1590--1594},
  issn = {1558-2361},
  doi = {10.1109/LSP.2024.3411510},
  urldate = {2024-06-13},
  abstract = {Acoustic vortices carrying orbital angular momentum (OAM) have great potential in underwater communication for improving the communication rate. However, generating high-quality acoustic vortices using a sonar array remains a challenge. The mode-matching approach is an effective way to reconstruct a desired acoustic field within a closed array. In this letter, we propose a mode-matching approach for any acoustic vortex fields using a planar circular array, including uniform and non-uniform arrays, with spherical harmonic expansion. The derivation of formulation to calculate the array driving function is given and numerical simulation is performed. We analyzed the influence of selecting the truncation order and the results indicate that using a finite truncation order to synthesize the acoustic vortex field is feasible. In addition, the simulation results of our proposed approach show that the generated acoustic vortex field has higher accuracy in both uniform circular array (UCA) and non-uniform circular array (NUCA) scenarios than the traditional method.},
  keywords = {Acoustic arrays,Acoustic field,Acoustic vortex,acoustics,circular array,generation,Harmonic analysis,mode-matching method,orbital angular momentum (OAM),Phased arrays,Principal component analysis,spherical harmonic expansion,Transducers,Underwater communication,vortex},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\QPSWUXTD\\Lu et al_2024_A Mode-Matching Approach for Acoustic Vortex Generation in Circular Array.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\MZRLXUF9\\10552037.html}
}

