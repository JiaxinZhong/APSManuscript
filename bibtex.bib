@article{Shin2020ImageConditionsEllipticalCoordinate,
  title = {Image {{Conditions}} for {{Elliptical-Coordinate Separation-of-Variables Acoustic Multiple Scattering Models}} with {{Perfectly Reflecting Flat Boundaries}}: {{Application}} to in {{Situ Tunable Noise Barriers}}},
  shorttitle = {Image {{Conditions}} for {{Elliptical-Coordinate Separation-of-Variables Acoustic Multiple Scattering Models}} with {{Perfectly Reflecting Flat Boundaries}}},
