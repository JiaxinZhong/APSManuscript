  doi = {10.1016/j.optcom.2025.131719},
  urldate = {2025-03-18},
  abstract = {The hybrid skin-topological effect has attracted widespread attention. This phenomenon arises from the interplay between the non-Hermitian skin effect (NHSE) and topological effects, hence it is also referred to as the hybrid second-order skin-topological effect. However, current research has been confined to gain-loss balanced systems, and achieving the desired optical field response typically requires sophisticated parameter tuning. Here we demonstrate that this phenomenon can also emerge under imbalanced conditions, and further introduce a deep learning framework to predict the optical field distribution. In this work, we propose a tandem network architecture that integrates a convolutional neural network (CNN) with a deep neural network (DNN) to achieve inverse design of the NHSE in photonic crystals (PhCs). Our results demonstrate that the proposed network not only resolves the many-to-one mapping challenge between NHSE characteristics and structural parameters but also successfully implements inverse design of second-order NHSE structures.},
  keywords = {Deep learning,non-Hermitian skin states,Photonic crystal},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\NBPBV2M6\\Shi和Hao - 2025 - Inverse Design of Non-Hermitian Skin States in Photonic Crystals via Deep Learning.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\ACZLQN8W\\S0030401825002470.html}
}

