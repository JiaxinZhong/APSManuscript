@article{Ward2015BoundarylayerEffectsAcoustic,
  title = {Boundary-Layer Effects on Acoustic Transmission through Narrow Slit Cavities},
  author = {Ward, G. P. and Lovelock, R. K. and Murray, A. R. J. and Hibbins, A. P. and Sambles, J. R. and Smith, J. D.},
  year = {2015},
  month = jul,
  journal = {Phys. Rev. Lett.},
  volume = {115},
  number = {4},
  pages = {044302},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevLett.115.044302},
  urldate = {2022-12-31},
  abstract = {We explore the slit-width dependence of the resonant transmission of sound in air through both a slit array formed of aluminum slats and a single open-ended slit cavity in an aluminum plate. Our experimental results accord well with Lord Rayleigh's theory concerning how thin viscous and thermal boundary layers at a slit's walls affect the acoustic wave across the whole slit cavity. By measuring accurately the frequencies of the Fabry-Perot-like cavity resonances, we find a significant 5\% reduction in the effective speed of sound through the slits when an individual viscous boundary layer occupies only 5\% of the total slit width. Importantly, this effect is true for any airborne slit cavity, with the reduction being achieved despite the slit width being on a far larger scale than an individual boundary layer's thickness. This work demonstrates that the recent prevalent loss-free treatment of narrow slit cavities within acoustic metamaterials is unrealistic.},
  keywords = {boundary layer effect},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\7UVZATU2\\Ward et al_2015_Boundary-Layer Effects on Acoustic Transmission Through Narrow Slit Cavities.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\8ENPUIV2\\fig1supplementary.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\AWU3UVXR\\supplementary.tex;C\:\\Users\\MrJia\\Zotero\\storage\\UHLSS247\\supplementary.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\YBDPAGT5\\supplementary.bbl;C\:\\Users\\MrJia\\Zotero\\storage\\9M39UWWS\\PhysRevLett.115.html}
