@article{Xu2024CatalogTopologicalPhonon,
  title = {Catalog of Topological Phonon Materials},
  author = {Xu, Yuanfeng and Vergniory, M. G. and Ma, Da-Shuai and Ma{\~n}es, Juan L. and Song, Zhi-Da and Bernevig, B. Andrei and Regnault, Nicolas and Elcoro, Luis},
  year = {2024},
