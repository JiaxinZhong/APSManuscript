@article{Liu2024LocalizationChiralEdge,
  title = {Localization of {{Chiral Edge States}} by the {{Non-Hermitian Skin Effect}}},
  author = {Liu, Gui-Geng and Mandal, Subhaskar and Zhou, Peiheng and Xi, Xiang and Banerjee, Rimi and Hu, Yuan-Hang and Wei, Minggui and Wang, Maoren and Wang, Qiang and Gao, Zhen and Chen, Hongsheng and Yang, Yihao and Chong, Yidong and Zhang, Baile},
