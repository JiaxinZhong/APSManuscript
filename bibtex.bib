@article{Deppisch2023DirectResidualSubspace,
  title = {Direct and {{Residual Subspace Decomposition}} of {{Spatial Room Impulse Responses}}},
  author = {Deppisch, Thomas and Gar{\'i}, Sebasti{\`a} V. Amengual and Calamia, Paul and Ahrens, Jens},
