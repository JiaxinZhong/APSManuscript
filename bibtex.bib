@article{Dick2016ComparisonMeasuredRoom,
  title = {A Comparison of Measured Room Acoustics Metrics Using a Spherical Microphone Array and Conventional Methods},
  author = {Dick, David A. and Vigeant, Michelle C.},
  year = {2016},
  month = jun,
  journal = {Applied Acoustics},
  volume = {107},
  pages = {34--45},
