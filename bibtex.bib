  urldate = {2024-12-19},
  abstract = {In this work, we present a novel method called the complex frequency fingerprint (CFF) to detect the complex frequency Green's function, \$G({\textbackslash}omega{\textbackslash}in{\textbackslash}mathbb\{C\})\$, in a driven-dissipative system. By utilizing the CFF, we can measure the complex frequency density of states (DOS) and local DOS (LDOS), providing unique insights into the characterization of non-Hermitian systems. By applying our method to systems exhibiting the non-Hermitian skin effect (NHSE), we demonstrate how to use our theory to detect both the non-Hermitian eigenvalues and eigenstates. This offers a distinctive and reliable approach to identifying the presence or absence of NHSE in experimental settings.},
