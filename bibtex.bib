@misc{Lieu2017TopologicalPhasesNonHermitian,
  title = {Topological Phases in the Non-{{Hermitian Su-Schrieffer-Heeger}} Model},
  author = {Lieu, Simon},
  year = {2017},
  month = sep,
  journal = {arXiv.org},
  doi = {10.1103/PhysRevB.97.045106},
  urldate = {2024-03-15},
  abstract = {We address the conditions required for a \${\textbackslash}mathbb\{Z\}\$ topological classification in the most general form of the non-Hermitian Su-Schrieffer-Heeger (SSH) model. Any chirally-symmetric SSH model will possess a "conjugated-pseudo-Hermiticity" which we show is responsible for a quantized "complex" Berry phase. Consequently, we provide the first example where the complex Berry phase of a band is used as a quantized invariant to predict the existence of gapless edge modes in a non-Hermitian model. The chirally-broken, \$PT\$-symmetric model is studied; we suggest an explanation for why the topological invariant is a global property of the Hamiltonian. A geometrical picture is provided by examining eigenvector evolution on the Bloch sphere. We justify our analysis numerically and discuss relevant applications.},
  howpublished = {https://arxiv.org/abs/1709.03788v2},
  langid = {english},
  file = {C:\Users\MrJia\Zotero\storage\W6U7HNHQ\Lieu_2017_Topological phases in the non-Hermitian Su-Schrieffer-Heeger model.pdf}
}

