  doi = {10.1109/TASLP.2022.3158187},
  abstract = {Sound field reproduction aims to reconstruct a desired sound field in a listening area by using multiple loudspeakers. To improve sound field reproduction performance, several loudspeaker placement methods have been proposed to select suitable loudspeaker positions. However, most conventional loudspeaker placement methods do not consider the distribution characteristic of the desired sound fields such as the distribution of directions from where the sound wave emanates, making these methods not optimal when the prior knowledge of the distribution characteristic of the desired sound fields is known. In this paper, a weighted loudspeaker placement method is proposed, which considers optimizing the objective function that depends on a set of desired sound fields with different weights. This paper formulates the optimization problem for weighted loudspeaker placement, presenting three alternative discretization methods to obtain a more practical optimization problem, after which the group greedy method is used to solve the optimization problem to find the near-optimal loudspeaker setup. To validate the proposed method, numerical experiments aiming to reconstruct the desired sound wave from a restricted range are conducted. The results indicate that the proposed method performs well in both narrowband and broadband cases, because it can use prior knowledge of the distribution characteristic of the desired sound fields.},
  keywords = {Linear programming,Loudspeaker placement,Loudspeakers,Microphones,Motion pictures,Narrowband,Optimization,pressure matching,sound field control,sound field reproduction,sound zone control,Speech processing},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\SQQFRGEW\\Gao et al_2022_Weighted Loudspeaker Placement Method for Sound Field Reproduction.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\VHM4B7XY\\9732230.html}
