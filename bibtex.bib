  title = {A {{Compressive Sensing Approach}} for the {{Reconstruction}} of the {{Soundfield Produced}} by {{Directive Sources}} in {{Reverberant Rooms}}},
  author = {Damiano, Stefano and Borra, Federico and Bernardini, Alberto and Antonacci, Fabio and Sarti, Augusto},
