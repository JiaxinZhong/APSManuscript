@article{Shang2019MeasurementTemperatureDependentBulk,
  title = {Measurement of {{Temperature-Dependent Bulk Viscosities}} of {{Nitrogen}}, {{Oxygen}} and {{Air From Spontaneous Rayleigh-Brillouin Scattering}}},
  author = {Shang, Jingcheng and Wu, Tao and Wang, Hao and Yang, Chuanyin and Ye, Chenwen and Hu, Rongjing and Tao, Junzhong and He, Xingdao},
