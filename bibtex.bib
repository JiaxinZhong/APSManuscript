}

@article{Zhang2021AcousticNonHermitianSkin,
  title = {Acoustic Non-{{Hermitian}} Skin Effect from Twisted Winding Topology},
  author = {Zhang, Li and Yang, Yihao and Ge, Yong and Guan, Yi-Jun and Chen, Qiaolu and Yan, Qinghui and Chen, Fujia and Xi, Rui and Li, Yuanzhen and Jia, Ding and Yuan, Shou-Qi and Sun, Hong-Xiang and Chen, Hongsheng and Zhang, Baile},
