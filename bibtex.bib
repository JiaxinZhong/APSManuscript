}

@article{Zhang2025AlgebraicNonHermitianSkin,
  title = {Algebraic {{Non-Hermitian Skin Effect}} and {{Generalized Fermi Surface Formula}} in {{Arbitrary Dimensions}}},
  author = {Zhang, Kai and Shu, Chang and Sun, Kai},
  year = {2025},
