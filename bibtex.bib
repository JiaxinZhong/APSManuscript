@article{Periyasamy2014MonteCarloSimulation,
  title = {Monte {{Carlo}} Simulation of Light Transport in Turbid Medium with Embedded Object--Spherical, Cylindrical, Ellipsoidal, or Cuboidal Objects Embedded within Multilayered Tissues},
