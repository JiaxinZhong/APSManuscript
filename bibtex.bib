}

@article{Zou2021ObservationHybridHigherorder,
  title = {Observation of Hybrid Higher-Order Skin-Topological Effect in Non-{{Hermitian}} Topolectrical Circuits},
  author = {Zou, Deyuan and Chen, Tian and He, Wenjing and Bao, Jiacheng and Lee, Ching Hua and Sun, Houjun and Zhang, Xiangdong},
  year = {2021},
