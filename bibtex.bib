@article{Allevato2022AirCoupledUltrasonicSpiral,
  title = {Air-{{Coupled Ultrasonic Spiral Phased Array}} for {{High-Precision Beamforming}} and {{Imaging}}},
  author = {Allevato, Gianni and Rutsch, Matthias and Hinrichs, Jan and Haugwitz, Christoph and M{\"u}ller, Raphael and Pesavento, Marius and Kupnik, Mario},
