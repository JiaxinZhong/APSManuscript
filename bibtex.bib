@article{Lin2024ObservationTopologicalTransition,
  title = {Observation of {{Topological Transition}} in {{Floquet Non-Hermitian Skin Effects}} in {{Silicon Photonics}}},
  author = {Lin, Zhiyuan and Song, Wange and Wang, Li-Wei and Xin, Haoran and Sun, Jiacheng and Wu, Shengjie and Huang, Chunyu and Zhu, Shining and Jiang, Jian-Hua and Li, Tao},
