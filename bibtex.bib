@article{Xi2025LowphasenoiseSurfaceacousticwaveOscillator,
  title = {Low-Phase-Noise Surface-Acoustic-Wave Oscillator Using an Edge Mode of a Phononic Band Gap},
  author = {Xi, Zichen and Thomas, Joseph G. and Ji, Jun and Wang, Dongyao and Cen, Zengyu and Kravchenko, Ivan I. and Srijanto, Bernadeta R. and Yao, Yu and Zhu, Yizheng and Shao, Linbo},
