  pages = {110550},
  issn = {0003-682X},
  doi = {10.1016/j.apacoust.2025.110550},
  urldate = {2025-03-01},
  abstract = {Sound field reconstruction is a widely adopted methodology for estimating the spatial distribution of sound by measuring pressure at limited positions. This paper proposes an eigen plane wave expansion (ePWE) method to achieve sound reconstruction within an enclosed environment. This method exploits the sparse superposition of the acoustic modes of the enclosed sound field at low frequencies, offering a block sparsity formulation compatible with the block sparse Bayesian learning (BSBL) framework. The proposed ePWE method constructs a sensing matrix that depends solely on spatial factors, facilitating the direct processing of both time-domain and frequency-domain inputs. Unlike existing modal-based methods, it can handle arbitrary sound fields without making assumptions about the sound sources. Validation of the proposed method using public datasets demonstrates that the ePWE method, utilising the modal information obtained from simple numerical simulations, outperforms the conventional PWE method in reconstruction accuracy and robustness. Additional experiments validate the ePWE method in scenarios where the modes become increasingly overlapped and the targeted enclosure is damped, indicating broader applications for the proposed method. In general, the proposed ePWE method achieves highly accurate reconstruction of enclosed sound fields at low frequencies, even under adverse conditions. Moreover, it holds promise for integration with other methods to enhance the performance of sound field estimation and control.},
  keywords = {Compressed sensing,Enclosed sound field reconstruction,Modal theory,Plane wave expansion,Sparse Bayesian learning},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\WZLQIC57\\Xu et al. - 2025 - An eigen plane wave expansion method for reconstructing enclosed sound fields at low frequencies.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\FUEYYP34\\S0003682X25000222.html}
}

@misc{Xu2025OptimalSpectralTransport,
  title = {Optimal Spectral Transport of Non-{{Hermitian}} Systems},
  author = {Xu, Mingtao and Gong, Zongping and Yi, Wei},
  year = {2025},
  month = jan,
  number = {arXiv:2501.15209},
  eprint = {2501.15209},
  primaryclass = {quant-ph},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2501.15209},
  urldate = {2025-03-04},
  abstract = {The optimal transport problem seeks to minimize the total transportation cost between two distributions, thus providing a measure of distance between them. In this work, we study the optimal transport of the eigenspectrum of one-dimensional non-Hermitian models as the spectrum deforms on the complex plane under a varying imaginary gauge field. Notably, according to the non-Bloch band theory, the deforming spectrum continuously connects the eigenspectra of the original non-Hermitian model (with vanishing gauge field) under different boundary conditions. It follows that the optimal spectral transport should contain key information of the model. Characterizing the optimal spectral transport through the Wasserstein metric, we show that, indeed, important features of the non-Hermitian model, such as the (auxiliary) generalized Brillouin zone, the non-Bloch exceptional point, and topological phase transition, can be determined from the Wasserstein-metric calculation. We confirm our conclusions using concrete examples. Our work highlights the key role of spectral geometry in non-Hermitian physics, and offers a practical and convenient access to the properties of non-Hermitian models.},
  archiveprefix = {arXiv},
  keywords = {Condensed Matter - Mesoscale and Nanoscale Physics,Condensed Matter - Quantum Gases,Quantum Physics},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\77W2R8CT\\Xu et al. - 2025 - Optimal spectral transport of non-Hermitian systems.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\Q9CTQMUY\\2501.html}
}

@article{Xu2025StateArtLowFrequency,
