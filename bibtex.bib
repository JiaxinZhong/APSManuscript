@article{Chen2023LaserNanoprinting3D,
  title = {Laser Nanoprinting of {{3D}} Nonlinear Holograms beyond 25000 Pixels-per-Inch for Inter-Wavelength-Band Information Processing},
  author = {Chen, Pengcheng and Xu, Xiaoyi and Wang, Tianxin and Zhou, Chao and Wei, Dunzhao and Ma, Jianan and Guo, Junjie and Cui, Xuejing and Cheng, Xiaoyan and Xie, Chenzhu and Zhang, Shuang and Zhu, Shining and Xiao, Min and Zhang, Yong},
