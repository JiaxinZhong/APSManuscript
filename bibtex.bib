  author = {Shi, Dongyuan and Gan, Woon-Seng and Lam, Bhan and Luo, Zhengding and Shen, Xiaoyi},
  year = {2023},
  journal = {IEEE/ACM Transactions on Audio, Speech, and Language Processing},
