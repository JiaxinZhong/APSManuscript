  urldate = {2023-06-20},
  abstract = {Parametric sonar is well-known for its effectiveness in transmitting narrow beams of low-frequency detection signals. The principle of parametric sonar involves the use of a parametric acoustic array, where a self-demodulated wave is accumulatively recovered along the propagation of an amplitude-modulated high-frequency carrier wave. When the modulating signal is a detection signal, both linear and harmonic distortions are introduced in the self-demodulated wave. The seminal constant false alarm rate (CFAR) detector may process the distortions separately, but the relationship between the detection signal and its distortions is theoretically described by nonlinear partial differential equations, which do not have an analytical solution in practical circumstances. To resolve this problem, this paper proposes a physics-informed neural network (PINN) for CFAR detection with parametric sonar. The PINN utilizes an approximate solution to the Khokhlov-Zabolotskaya-Kuznetsov (KZK) equation to obtain physical information about the distortions of the detection signal. The training process of the PINN employs the weighted cross entropy loss to achieve CFAR detection by controlling the weights of target-present and target-absent. Numerical experiments demonstrate that the proposed PINN outperforms conventional CFAR detectors in scenarios involving target detection and sub-bottom profiling with parametric sonar amidst ocean noise.},
  langid = {english},
  keywords = {constant false alarm rate,PAA,Parametric sonar,physics-informed neural network,weighted cross entropy loss},
  file = {C:\Users\MrJia\Zotero\storage\R94VKRTX\Gou et al_2023_Physics-Informed Neural Network for Cfar Detection with Parametric Sonar.pdf}
}

