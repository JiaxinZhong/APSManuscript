  langid = {english},
  keywords = {Silicon photonics,Topological insulators},
  file = {C:\Users\MrJia\Zotero\storage\WPQCIUDJ\Huang et al. - 2024 - Hyperbolic photonic topological insulators.pdf}
}

@misc{Huang2025ComplexFrequencyDetection,
  title = {Complex {{Frequency Detection}} in a {{Subsystem}}},
  author = {Huang, Juntao and Hu, Jiangping and Yang, Zhesen},
  year = {2025},
