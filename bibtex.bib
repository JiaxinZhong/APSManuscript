  author = {He, H. and He, C. and Chang, J. and Lv, D. and Wu, J. and Duan, C. and Zhou, Q. and Zeng, N. and He, Y. and Ma, H.},
  year = {2017},
  month = may,
  journal = {J Biophotonics},
