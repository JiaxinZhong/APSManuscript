@article{Wortche2025CharacterizingUltrasonicStanding,
  title = {Characterizing Ultrasonic Standing Wave Fields by Schlieren Imaging},
  author = {W{\"o}rtche, Frederike S. L. and Maucher, Fabian and Mooiweer, Martijn and Verbiest, Gerard J. and Steeneken, Peter G.},
