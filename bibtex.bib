@article{Hasegawa2020VolumetricAcousticHolography,
  title = {Volumetric Acoustic Holography and Its Application to Self-Positioning by Single Channel Measurement},
  author = {Hasegawa, Keisuke and Shinoda, Hiroyuki and Nara, Takaaki},
  year = {2020},
