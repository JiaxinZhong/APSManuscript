@article{Wang2024OnedimensionalNonHermitianBand,
  title = {One-Dimensional Non-{{Hermitian}} Band Structures as {{Riemann}} Surfaces},
  author = {Wang, Heming and Fan, Lingling and Fan, Shanhui},
  year = {2024},
