@article{Jia2023BoundStatesContinuum,
  title = {Bound {{States}} in the {{Continuum Protected}} by {{Reduced Symmetry}} of {{Three-Dimensional Open Acoustic Resonators}}},
  author = {Jia, Bin and Huang, Lujun and Pilipchuk, Artem S. and Huang, Sibo and Shen, Chen and Sadreev, Almas F. and Li, Yong and Miroshnichenko, Andrey E.},
  year = {2023},
  month = may,
  journal = {Phys. Rev. Appl.},
  volume = {19},
  number = {5},
  pages = {054001},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevApplied.19.054001},
  urldate = {2023-06-01},
  abstract = {Bound states in the continuum (BICs) have been demonstrated as a powerful tool for trapping acoustic fields in an acoustic resonator. It has been widely recognized that symmetry-protected (SP) BICs result from symmetry incompatibility of some eigenmodes of a resonator with propagating modes of waveguides. The most typical example of SP BIC is the odd eigenmode of the resonator with the eigenfrequency embedded into the propagating band of even propagating eigenmodes of the waveguide. In this work, we consider a more sophisticated case of an acoustic cuboid resonator that is opened by the attachment of two cylindrical waveguides. We show that BICs can be sustained in an open acoustic resonator with reduced symmetry. For symmetrical positions of waveguides, the eigenmodes of the cuboid can also be classified as SP BICs and show different stability against the shifts of waveguides from the positions of symmetry of the cuboid. We fabricate a series of coupled waveguide resonators and experimentally verify the existence of these BICs by identifying the vanished linewidth of Fano resonance in transmission spectra. Besides, we also show that evanescent modes of waveguides play a role in the formation of BICs in a nonaxisymmetric waveguide-resonator system by tuning the angle {\texttheta} between two waveguides. Consequently, the eigenmodes remain SP BICs for {\texttheta} = 0{$^\circ$} and {\texttheta} = 180{$^\circ$} but convert into accidental BICs at {\texttheta} {$\approx$} 85{$^\circ$}or {\texttheta} {$\approx$} 275{$^\circ$}. Such accidental BICs are also experimentally verified. Our results enrich the understanding of SP BICs and accidental BICs, and provide alternative methods of routing acoustic waves and designing acoustic devices requiring fine spectrum features, such as filters and sensors.},
  keywords = {bound state in the continuum,cylinder},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\3RXRJQ9X\\Jia et al_2023_Bound States in the Continuum Protected by Reduced Symmetry of.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\X55ALB4W\\PhysRevApplied.19.html}
}

@article{Jia2023TopologicalClassificationIntersection,
  title = {Topological Classification for Intersection Singularities of Exceptional Surfaces in Pseudo-{{Hermitian}} Systems},
  author = {Jia, Hongwei and Zhang, Ruo-Yang and Hu, Jing and Xiao, Yixin and Zhang, Shuang and Zhu, Yifei and Chan, C. T.},
  year = {2023},
  month = oct,
  journal = {Commun Phys},
  volume = {6},
  number = {1},
  pages = {1--8},
  publisher = {Nature Publishing Group},
  issn = {2399-3650},
  doi = {10.1038/s42005-023-01417-4},
  urldate = {2024-07-14},
  abstract = {Non-Hermitian systems are known for their intriguing topological properties, which underpin various exotic physical phenomena. Exceptional points, in particular, play a pivotal role in fine-tuning these systems for optimal device functionality and material characteristics. These points can give rise to exceptional surfaces with embedded lower-dimensional non-isolated singularities. Here we introduce a topological classification for non-defective intersection lines of exceptional surfaces, where exceptional surfaces intersect transversally. We achieve this classification by constructing a quotient space of an order-parameter space under equivalence relations of eigenstates. We unveil that the fundamental group of these gapless structures is a non-Abelian group on three generators. This classification not only reveals a unique form of non-Hermitian gapless phases featuring a chain of non-defective intersection lines but also predicts the unexpected existence of topological edge states in one-dimensional lattice models protected by the intersection singularities. Our classification opens avenues for realizing robust topological phases.},
  copyright = {2023 The Author(s)},
  langid = {english},
  keywords = {Applied physics,Condensed-matter physics},
  file = {C:\Users\MrJia\Zotero\storage\7GDF6VN7\Jia et al_2023_Topological classification for intersection singularities of exceptional.pdf}
}

@article{Jia2024CompactMetadifferentiatorAchieving,
  title = {Compact Meta-Differentiator for Achieving Isotropically High-Contrast Ultrasonic Imaging},
  author = {Jia, Yurou and Zhang, Suying and Zhang, Xuan and Long, Houyou and Xu, Caibin and Bai, Yechao and Cheng, Ying and Wu, Dajian and Deng, Mingxi and Qiu, Cheng-Wei and Liu, Xiaojun},
  year = {2024},
