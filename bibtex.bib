@article{Martin2016SimulatingFocusedUltrasound,
  title = {Simulating {{Focused Ultrasound Transducers Using Discrete Sources}} on {{Regular Cartesian Grids}}},
  author = {Martin, Eleanor and Ling, Yan To and Treeby, Bradley E.},
  year = {2016},
