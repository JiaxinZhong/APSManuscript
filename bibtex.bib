  journal = {Opt. Lett., OL},
  volume = {40},
  number = {7},
  pages = {1197--1200},
  publisher = {Optica Publishing Group},
  issn = {1539-4794},
  doi = {10.1364/OL.40.001197},
  urldate = {2023-04-22},
  abstract = {A stochastic-parallel-gradient-descent algorithm (SPGD) based on Zernike polynomials is proposed to generate the phase correction pattern for a distorted orbital angular momentum (OAM) beam. The Zernike-polynomial coefficients for the correction pattern are obtained by monitoring the intensity profile of the distorted OAM beam through an iteration-based feedback loop. We implement this scheme and experimentally show that the proposed approach improves the quality of the turbulence-distorted OAM beam. Moreover, we apply phase correction patterns derived from a probe OAM beam through emulated turbulence to correct other OAM beams transmitted through the same turbulence. Our experimental results show that the patterns derived this way simultaneously correct multiple OAM beams propagating through the same turbulence, and the crosstalk among these modes is reduced by more than 5\&\#xA0;dB.},
  copyright = {{\copyright} 2015 Optical Society of America},
  langid = {english},
  keywords = {Atmospheric turbulence,Light beams,Optical angular momentum,Spatial light modulators,Wavefront distortions,Zernike polynomials},
  file = {C:\Users\MrJia\Zotero\storage\244C3P5Q\Xie et al_2015_Phase correction for a distorted orbital angular momentum beam using a Zernike.pdf}
}

@article{Xie2015SinglesensorMultispeakerListening,
  title = {Single-Sensor Multispeaker Listening with Acoustic Metamaterials},
  author = {Xie, Yangbo and Tsai, Tsung-Han and Konneker, Adam and Popa, Bogdan-Ioan and Brady, David J. and Cummer, Steven A.},
  year = {2015},
