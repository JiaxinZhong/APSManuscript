@article{Guo2023ExceptionalNonAbelianTopology,
  title = {Exceptional {{Non-Abelian Topology}} in {{Multiband Non-Hermitian Systems}}},
  author = {Guo, Cui-Xian and Chen, Shu and Ding, Kun and Hu, Haiping},
  year = {2023},
