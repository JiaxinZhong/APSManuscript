  title = {Topological {{Defect Engineering}} and \${\textbackslash}mathcal\{\vphantom\}{{P}}\vphantom\{\}{\textbackslash}mathcal\{\vphantom\}{{T}}\vphantom\{\}\$ {{Symmetry}} in {{Non-Hermitian Electrical Circuits}}},
