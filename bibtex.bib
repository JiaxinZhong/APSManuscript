}

@article{Liu2022TopologicalChernVectors,
  title = {Topological {{Chern}} Vectors in Three-Dimensional Photonic Crystals},
  author = {Liu, Gui-Geng and Gao, Zhen and Wang, Qiang and Xi, Xiang and Hu, Yuan-Hang and Wang, Maoren and Liu, Chengqi and Lin, Xiao and Deng, Longjiang and Yang, Shengyuan A. and Zhou, Peiheng and Yang, Yihao and Chong, Yidong and Zhang, Baile},
  year = {2022},
