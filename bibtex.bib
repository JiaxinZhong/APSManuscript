@article{Ge2023ProgrammableDualbandAcoustic,
  title = {Programmable Dual-Band Acoustic Topological Insulator with Dynamically Movable Interface States},
  author = {Ge, Yong and Shi, Bin-jie and Xia, Jian-ping and Sun, Hong-xiang and Yuan, Shou-qi and Xue, Haoran and Zhang, Baile},
