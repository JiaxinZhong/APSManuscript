@article{Nakayama2025VirtualSoundSource,
  title = {Virtual {{Sound Source Construction Based}} on {{Direct-to-Reverberant Ratio Control Using Multiple Pairs}} of {{Parametric-Array Loudspeakers}} and {{Conventional Loudspeakers}}},
  author = {Nakayama, Masato and Ekawa, Takuma and Takahashi, Toru and Nishiura, Takanobu},
  year = {2025},
