@misc{Kim2025BoundaryDrivenComplexBrillouin,
  title = {Boundary-{{Driven Complex Brillouin Zone}} in {{Non-Hermitian Electric Circuits}}},
  author = {Kim, Yung and Verma, Sonu and Kyung, Minwook and Lee, Kyungmin and Liu, Wenwen and Zhang, Shuang and Min, Bumki and Park, Moon Jip},
  year = {2025},
