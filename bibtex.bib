@article{Walther2025MethodApproximatingHigh,
  title = {A Method for Approximating High Frequency Sound Radiation---{{The}} Plane Projection {{Rayleigh}} Integral},
  author = {Walther, Marius and Gerlach, Andr{\'e} and Liebler, Marko and Haugwitz, Christoph and Kupnik, Mario},
  year = {2025},
