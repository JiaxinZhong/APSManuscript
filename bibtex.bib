}

@article{Gao2024ControllingAcousticNonHermitian,
  title = {Controlling Acoustic Non-{{Hermitian}} Skin Effect via Synthetic Magnetic Fields},
  author = {Gao, He and Zhu, Weiwei and Xue, Haoran and Ma, Guancong and Su, Zhongqing},
  year = {2024},
  month = jul,
