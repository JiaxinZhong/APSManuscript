  pages = {014025},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevApplied.22.014025},
  urldate = {2024-10-31},
  abstract = {In topological crystalline insulators, the presence of crystalline symmetries can lead to a filling anomaly---a mismatch in electron counts that causes quantized fractional charges at boundaries. These charges act as a critical probe of crystalline topology and are notably present even in electrically neutral systems, including artificial photonic and phononic systems. In these contexts, the boundary-localized fractional charges are represented by the local density of states, which is integrated over a specific frequency range (and is referred to as the integrated mode density). Here we report our measurement of the local density of states in an elastic wave lattice system. We propose an accurate approach to the measurement of the system's Green's function, achieved through piezoelectric transducer excitation and noncontact laser vibrometry detection. The experimental design includes both one-dimensional elastic plates and two-dimensional lattices with disclination defects. The experimental results conclusively show quantitative differentiation of these phases as well as the fractional charge, i.e., the fractional integrated mode density trapped in disclinations. Our approach provides valuable insights into the measurement of the local density of states in elastic systems, with implications for vibration enhancement and structural vibration control.},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\PV3M52NQ\\Liu et al. - 2024 - Measurement of fractional charge in elastic plates with disclinations.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\BRK2VLJS\\PhysRevApplied.22.html}
}

@article{Liu2024ObservationBulkdislocationCorrespondence,
  title = {Observation of Bulk-Dislocation Correspondence in Photonic Crystals},
  author = {Liu, Yang and Zhang, Xiao and Liang, Cheng-Peng and Li, Fei-Fei and Poo, Yin and Jiang, Jian-Hua},
  year = {2024},
  month = dec,
  journal = {Phys. Rev. Appl.},
  volume = {22},
  number = {6},
  pages = {064097},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevApplied.22.064097},
  urldate = {2025-01-02},
  abstract = {The emergence of topological edge states is a key feature of various topological phases. This phenomenon, termed the bulk-edge correspondence, is regarded as the major experimental signature of topological materials. Recent theoretical studies reveal that topological defects, such as dislocations, can reveal more information about the topological properties of the hosting materials. Here, we observe such a phenomenon in experiments by engineering dislocations in topological photonic crystals. Instead of the topological edge states, we show that a fractional topological number and a local mode bound to the dislocation can emerge as the experimental manifestation of the underlying topology. The fractional topological number depends on both the photonic band topology in momentum space and the geometry of the dislocation in real space and, thus, it serves as a versatile probe of the band topology. We confirm with experiments that the photonic band topology can indeed be inferred from the fractional topological numbers at various dislocations, uncovering the underlying bulk-defect correspondence. Moreover, the geometry of the dislocation can be engineered, which in turn affects the fractional topological number, indicating the role of the real-space topology of the dislocation. Our work serves as a stepping stone toward probing topological phases with dislocations, especially for crystalline materials and metamaterials with time-reversal symmetry.},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\63H6RABX\\Liu et al. - 2024 - Observation of bulk-dislocation correspondence in photonic crystals.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\EJZDIZG2\\PhysRevApplied.22.html}
}

