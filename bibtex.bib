@article{Lodge2005StrategiesControllingIntra,
  title = {Strategies for Controlling Intra- and Intermicellar Packing in Block Copolymer Solutions: Illustrating the Flexibility of the Self-Assembly Toolbox},
  author = {Lodge, T. L. and Bang, J. and Li, Z. and Hillmyer, M. A. and Talmon, Y.},
  year = {2005},
  journal = {Faraday Discuss},
  edition = {2005/01/22},
  volume = {128},
  eprint = {15658763},
  eprinttype = {pubmed},
  pages = {1-12; discussion 87-101},
  issn = {1359-6640 (Print) 1359-6640 (Linking)},
  abstract = {Block copolymers constitute a class of self-assembling macromolecules that offer remarkable flexibility for controlling nanostructure, both in discrete objects and in bulk materials. Block copolymer micelles may be formed with multiple compartments by judicious choice of ingredients in an ABC triblock copolymer. For example, we have shown that a poly(ethylene oxide-b-styrene-b-fluorinated butadiene) triblock assembles in dilute aqueous solution into large, flat core/shell/corona disks, with the fluorine containing block forming the core. In contrast, the unfluorinated precursor generates large spherical micelles. A numerical analysis suggests that the disk-like motif is characteristic of the so-called superstrong segregation regime, whereby the interfacial tension becomes so large as to overwhelm the conformational entropy of the core blocks. For ABC miktoarm stars comprising polyethylene oxide, polyethylethylene, and polyhexafluoropropylene oxide arms, a much richer variety of micellar structures are observed. Prominent amongst these is a "segmented worm", in which alternating layers (5-7 nm thick) of hydrocarbon and fluorocarbon blocks form disks (6-10 nm in radius) that stack into cylindrical aggregates. The disk radii suggest almost fully stretched blocks, again consistent with the superstrong segregation regime. These structures are rationalized in terms of the constraints imposed by the star architecture, combined with the extremely strong interfacial tensions. In contrast, for lipids, surfactants, and aqueous diblock copolymers, increasing the interfacial tension can induce a transition from spheres to cylinders to flat bilayers; the disk-like motif is not usually seen. Interestingly, in aqueous diblocks both worm-like micelles and vesicles have been well-documented, whereas in "simple" organic systems they have not. We have shown that by suitable choice of block composition and solvent selectivity, the curvature sequence sphere/cylinder/vesicle can also be observed in poly(styrene-b-isoprene) diblocks in dialkyl phthalates. In more concentrated solutions such spherical micelles assemble onto body-centered or face-centered cubic lattices. In some cases a thermoreversible fcc/bcc transition has been noted. We have recently demonstrated that this transition corresponds to a particular aggregation number; higher aggregation numbers, found at lower temperatures, favor the "hard-sphere-like" fcc packing. All of these results are based on a combination of dynamic light scattering, small angle X-ray and neutron scattering, and cryogenic transmission electron microscopy.}
}

@article{Loh2025Kinematics6DofRobotic,
  title = {Kinematics of 6-{{Dof}} Robotic Arm with Acoustic Gripper},
  author = {Loh, Jun Ren},
  year = {2025},
  eprint = {10356/200086},
  eprinttype = {hdl},
  publisher = {Nanyang Technological University},
  urldate = {2025-07-04},
  abstract = {This project constitutes the design and analysis of a six-degrees-of-freedom (6-DoF) robotic arm paired with an acoustic gripper to support contactless picking and placing of small objects inside a limited working area. Based on non-contact 3D manipulation by acoustic levitation, the project evolved to focus on robotic arm kinematics, prompting the installation of a hybrid setup that integrates mechanical actuation and acoustic levitation. The arm kinematics were described using the Denavit-Hartenberg (D-H) convention, and forward and inverse kinematic solutions were implemented in MATLAB and Python. A numerical inverse kinematics approach was used due to the complexity of the 6-DoF system, with joint constraints enforced to mimic actual servo limits. Ultrasonic transducers controlled by ESP32 microcontrollers drove the acoustic gripper. Experimental validation included the simulation of target trajectories and manual adjustment of joint angles in terms of correct path following and object handling. Troubles encountered include discrepancies between the simulated and the real robots, orientation differences in the joint angles, and instability in the current supply. It is advised that future research be performed on machine learning-based visual recognition to adaptive manipulation, actuator miniaturization, and integration on mobile robots.},
  langid = {english},
