  journal = {IEEE Trans. Ultrason. Ferroelectr. Freq. Control},
  volume = {45},
  number = {3},
  pages = {626--633},
  issn = {1525-8955},
  doi = {10.1109/58.677607},
  abstract = {A noncontact ultrasonic method for measuring the surface normal vibration of objects was studied. The instrument consists of a pair of 420 kHz ultrasonic air transducers. One is used to emit ultrasounds toward the moving surface, and the other receives the ultrasound reflected from the object under test. Two effects induce a phase modulation on the received signal. The first effect results from the variation of the round trip time interval /spl tau/ required for the wavefront to go from the emitter to the moving surface and back to the receiver. This is the Doppler effect directly proportional to the surface displacement. The second effect results from the nonlinear parametric interactions of the ultrasonic beams (forward and backward) with the low frequency sound field emitted in the air by the vibrating surface. This latter phenomenon, which is a volume effect, is proportional to the velocity of the vibrating surface and increases with the distance between the transducers and the surface under test. The relative contribution of the Doppler and parametric effects are evaluated, and both have to be taken into account for ultrasonic interferometry in air.},
  keywords = {Doppler effect,Frequency,Instruments,Phase modulation,Surface waves,Testing,Ultrasonic imaging,Ultrasonic transducers,Ultrasonic variables measurement,Vibration measurement},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\PF6AXY57\\Mater et al_1998_Noncontact measurement of vibration using airborne ultrasound.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\6SFE7Y3Q\\677607.html}
