@article{Piao2015GeometryDependenceDifferential,
  title = {On the Geometry Dependence of Differential Pathlength Factor for Near-Infrared Spectroscopy. {{I}}. {{Steady-state}} with Homogeneous Medium},
  author = {Piao, D. and Barbour, R. L. and Graber, H. L. and Lee, D. C.},
