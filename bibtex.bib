@article{Hu2022AirybeamenabledBinaryAcoustic,
  title = {Airy-Beam-Enabled Binary Acoustic Metasurfaces for Underwater Ultrasound-Beam Manipulation},
  author = {Hu, Zhongtao and Yang, Yaoheng and Xu, Lu and Jing, Yun and Chen, Hong},
  year = {2022},
