@article{Sciallero2021Wideband2DSparse,
  title = {Wideband 2-{{D}} Sparse Array Optimization Combined with Multiline Reception for Real-Time 3-{{D}} Medical Ultrasound},
  author = {Sciallero, Claudia and Trucco, Andrea},
  year = {2021},
