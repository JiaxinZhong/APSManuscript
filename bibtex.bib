@article{Williams2022MultidegreeofFreedomStateSpaceModeling,
  title = {Multidegree-of-{{Freedom State-Space Modeling}} of {{Nonlinear Pull-in Dynamics}} of an {{Electrostatic MEMS Microphone}}},
