  keywords = {DeepXDE,Forward Problem,Frequency division multiplexing,Mathematical models,Neural networks,Numerical Modelling,Numerical models,physics-informed neural network,Physics-Informed Neural Networks,Propagation,Training,Ultrasonic imaging,Wave Equation},
