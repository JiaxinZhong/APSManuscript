@article{Ke2014EffectLocalChain,
  title = {Effect of Local Chain Deformability on the Temperature-Induced Morphological Transitions of Polystyrene-b-Poly({{N-isopropylacrylamide}}) Micelles in Aqueous Solution},
  author = {Ke, X. X. and Wang, L. and Xu, J. T. and Du, B. Y. and Tu, Y. F. and Fan, Z. Q.},
