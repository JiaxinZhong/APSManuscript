@article{Koponen2019AcousticPressureField,
  title = {Acoustic Pressure Field Estimation Methods for Synthetic Schlieren Tomography},
  author = {Koponen, Eero and Leskinen, Jarkko and Tarvainen, Tanja and Pulkkinen, Aki},
  year = {2019},
  month = apr,
  journal = {The Journal of the Acoustical Society of America},
  volume = {145},
