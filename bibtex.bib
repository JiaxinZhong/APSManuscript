@article{Gong2018TopologicalPhasesNonHermitian,
  title = {Topological {{Phases}} of {{Non-Hermitian Systems}}},
  author = {Gong, Zongping and Ashida, Yuto and Kawabata, Kohei and Takasan, Kazuaki and Higashikawa, Sho and Ueda, Masahito},
  year = {2018},
  month = sep,
  journal = {Phys. Rev. X},
  volume = {8},
