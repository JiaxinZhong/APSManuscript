@article{Towlson2024AirCoupledUltrasonicArrays,
  title = {Air-{{Coupled Ultrasonic Arrays}} for {{Assessment}} of {{Pipe Internal Geometry}} and {{Surface Condition}}},
  author = {Towlson, Alexander R. K. and Croxford, Anthony J. and Drinkwater, Bruce W.},
  year = {2024},
