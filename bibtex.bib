@article{Chen2024CalibratingPositionOrientation,
  title = {Calibrating Position and Orientation of Multiple Ultrasound Phased Array Units Using {{Bayesian}} Optimization},
  author = {Chen, Jianyu and Suzuki, Shun and Makino, Yasutoshi and Shinoda, Hiroyuki},
  year = {2024},
