@article{Tian2022FarFieldSubwavelengthAcoustic,
  title = {Far-{{Field Subwavelength Acoustic Computational Imaging}} with a {{Single Detector}}},
  author = {Tian, Yuan and Ge, Hao and Zhang, Xiu-Juan and Xu, Xiang-Yuan and Lu, Ming-Hui and Jing, Yun and Chen, Yan-Feng},
