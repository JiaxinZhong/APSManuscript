}

@misc{Hasegawa2024FocusingAirborneUltrasound,
  title = {Focusing {{Airborne Ultrasound}} with {{Partially Occluded Emission}} from {{Rectangular Plate}} with {{Flexural Vibration Mode}}},
  author = {Hasegawa, Keisuke and Fujimori, Masaya and Takasaki, Masaya},
  year = {2024},
