}

@article{Zhang2024NonreciprocalAcousticDevices,
  title = {Nonreciprocal {{Acoustic Devices}} with {{Asymmetric Peierls Phases}}},
  author = {Zhang, Li and Ge, Yong and Guan, Yi-jun and Chen, Fujia and Han, Ning and Chen, Qiaolu and Pan, Yuang and Jia, Ding and Yuan, Shou-qi and Sun, Hong-xiang and Christensen, Johan and Chen, Hongsheng and Yang, Yihao},
  year = {2024},
  month = sep,
  journal = {Phys. Rev. Lett.},
  volume = {133},
  number = {13},
  pages = {136601},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevLett.133.136601},
  urldate = {2024-09-26},
  abstract = {Nonreciprocity in acoustics is of paramount importance in many practical applications and has been experimentally realized using nonlinear media, moving fluids, or time modulation, which regrettably suffer from large volumes and high-power consumption, difficulty in integration, and inevitable vibrations or phase noise. In modern Hamiltonian theory, the violation of system's reciprocity can be achieved via asymmetric Peierls phases, which typically involves with non-Hermiticity or time-reversal symmetry breaking. Here, we propose a framework for designing nonreciprocal acoustic devices based on the asymmetric Peierls phases that can be fully controlled via active acoustic components. The fully controlled Peierls phases enable various high-performance acoustic devices, including non-Hermitian extensions of isolators, gyrators, and circulators, which are otherwise impossible in previous approaches that are bound by Hermiticity or passivity. We reveal that the transmission phases in isolators are equivalent to the Peierls phase plus a constant. The nonreciprocal phase delay in gyrators and the unirotational transmission behavior in circulators result from the gauge-invariant Aharonov-Bohm phases determined by Peierls phases. Our work not only uncovers multiple intriguing physics related to Peierls phases but also provides a general approach to compact, integratable, nonreciprocal acoustic devices.},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\N3NAJWD3\\Supplementary_Materials.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\YYP5M3LM\\Zhang et al. - 2024 - Nonreciprocal Acoustic Devices with Asymmetric Peierls Phases.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\458MIWHC\\PhysRevLett.133.html}
}

@article{Zhang2024ObservationContinuumLandau,
  title = {Observation of Continuum {{Landau}} Modes in Non-{{Hermitian}} Electric Circuits},
  author = {Zhang, Xuewei and Wu, Chaohua and Yan, Mou and Liu, Ni and Wang, Ziyu and Chen, Gang},
  year = {2024},
  month = feb,
  journal = {Nat Commun},
  volume = {15},
  number = {1},
  pages = {1798},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-024-46122-0},
  urldate = {2024-06-17},
  abstract = {Continuum Landau modes --- predicted recently in a non-Hermitian Dirac Hamiltonian under a uniform magnetic field --- are continuous bound states with no counterparts in Hermitian systems. However, they have still not been confirmed in experiments. Here, we report an experimental observation of continuum Landau modes in non-Hermitian electric circuits, in which the non-Hermitian Dirac Hamiltonian is simulated by non-reciprocal hoppings and the pseudomagnetic field is introduced by inhomogeneous complex on-site potentials. Through measuring the admittance spectrum and the eigenstates, we successfully verify key features of continuum Landau modes. Particularly, we observe the exotic voltage response acting as a rainbow trap or wave funnel through full-field excitation. This response originates from the linear relationship between the modes' center position and complex eigenvalues. Our work builds a bridge between non-Hermiticity and magnetic fields, and thus opens an avenue to explore exotic non-Hermitian physics.},
  copyright = {2024 The Author(s)},
  langid = {english},
  keywords = {Metamaterials,Photonic crystals},
  file = {C:\Users\MrJia\Zotero\storage\EEYM4DS7\Zhang et al_2024_Observation of continuum Landau modes in non-Hermitian electric circuits.pdf}
}

