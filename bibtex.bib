  urldate = {2023-08-10},
  abstract = {Abundant theoretical and experimental work has shown that axisymmetric transducer fields can be accurately and efficiently represented by a superposition of Gaussian beams. The historical disadvantage of the Gaussian-beam expansion is that the non-linear expansion coefficients must be determined through a numerically expensive least-squares optimization approach. We present an efficient approach for determining these coefficients based on a classical signal processing technique known as Prony's method. Prony's method replaces iterative optimization by a polynomial root-finding problem, and can be three orders of magnitude faster than a conventional iterative optimization approach. Fitting Gaussian beams to synthetic waveform data using Prony's method shows excellent agreement with the original data in the absence of noise, and testing with additive noise indicates that Prony's method is robust. When Prony's method and iterative, least-squares optimization are applied to experimental data, the results are not identical, but both provide a reasonably good fit.},
  langid = {english},
  keywords = {Gaussian beams,Prony's method,Transducer modeling},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\P3V2VML2\\Prange_Shenoy_1996_A fast Gaussian beam description of ultrasonic fields based on Prony's method.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\DZKC7FGT\\0041624X96000042.html}
