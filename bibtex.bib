  doi = {10.1103/PhysRevLett.126.040603},
  urldate = {2024-01-18},
  abstract = {Using synthetic lattices of laser-coupled atomic momentum modes, we experimentally realize a recently proposed family of nearest-neighbor tight-binding models having quasiperiodic site energy modulation that host an exact mobility edge protected by a duality symmetry. These one-dimensional tight-binding models can be viewed as a generalization of the well-known Aubry-Andr{\'e} model, with an energy-dependent self-duality condition that constitutes an analytical mobility edge relation. By adiabatically preparing low and high energy eigenstates of this model system and performing microscopic measurements of their participation ratio, we track the evolution of the mobility edge as the energy-dependent density of states is modified by the model's tuning parameter. Our results show strong deviations from single-particle predictions, consistent with attractive interactions causing both enhanced localization of the lowest energy state due to self-trapping and inhibited localization of high energy states due to screening. This study paves the way for quantitative studies of interaction effects on self-duality induced mobility edges.},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\BYIRX9ST\\GAA_paper_supplement.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\Y5CPNQHT\\An et al_2021_Interactions and Mobility Edges.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\DYEX2MP7\\PhysRevLett.126.html}
}

@article{An2021NonlinearDynamicsSynthetic,
