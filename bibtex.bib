@article{Gao2019MajoranalikeZeroModes,
  title = {Majorana-like {{Zero Modes}} in {{Kekul}}{\textbackslash}'e {{Distorted Sonic Lattices}}},
  author = {Gao, Penglin and Torrent, Daniel and Cervera, Francisco and {San-Jose}, Pablo and {S{\'a}nchez-Dehesa}, Jos{\'e} and Christensen, Johan},
  year = {2019},
