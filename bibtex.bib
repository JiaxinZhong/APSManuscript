@article{Yan2016SynthesisPlanarSparse,
  title = {Synthesis of Planar Sparse Arrays by Perturbed Compressive Sampling Framework},
  author = {Yan, Fei and Yang, Peng and Yang, Feng and Dong, Tao},
  year = {2016},
  journal = {IET Microwaves, Antennas \& Propagation},
