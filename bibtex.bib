}

@article{Kaleris2024LaserplasmaSoundSources,
  title = {Laser-Plasma Sound Sources in Atmospheric Air: {{A}} Systematic Experimental Study},
  shorttitle = {Laser-Plasma Sound Sources in Atmospheric Air},
  author = {Kaleris, Konstantinos and Orphanos, Yannis and Petrakis, Stelios and Bakarezos, Makis and Tatarakis, Michael and Mourjopoulos, John and Papadogiannis, Nektarios A.},
