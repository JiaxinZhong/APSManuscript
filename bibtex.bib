@article{Shirado2023EmergenceCollapseReciprocity,
  title = {Emergence and Collapse of Reciprocity in Semiautomatic Driving Coordination Experiments with Humans},
  author = {Shirado, Hirokazu and Kasahara, Shunichi and Christakis, Nicholas A.},
  year = {2023},
