@article{Pu2021AutofocusingAcousticvortexTweezers,
  title = {Auto-Focusing Acoustic-Vortex Tweezers for Obstacle-Circumventing Manipulation},
  author = {Pu, Shifu and Guo, Gepu and Guo, Xiasheng and Zhou, Chenchen and Li, Yuzhi and Ma, Qingyu and Tu, Juan and Zhang, Dong},
