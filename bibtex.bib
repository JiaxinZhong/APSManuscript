@article{Rawnaque2022EffectsElasticModulus,
  title = {The Effects of Elastic Modulus and Impurities on Bubble Nuclei Available for Acoustic Cavitation in Polyacrylamide Hydrogels},
  author = {Rawnaque, Ferdousi Sabera and Simon, Julianna C.},
  year = {2022},
  month = dec,
