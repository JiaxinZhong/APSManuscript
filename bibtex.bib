}

@article{Schneider2020FrequencyConversionNonlinear,
  title = {Frequency Conversion through Nonlinear Mixing in Acoustic Waves},
  author = {Schneider, Joseph D. and Lu, Ting and Tiwari, Sidhant and Zou, Xiating and Mal, Ajit and Candler, Robert N. and Wang, Yuanxun Ethan and Carman, Gregory P.},
