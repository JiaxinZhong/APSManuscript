}

@article{Cui2014CodingMetamaterialsDigital,
  title = {Coding Metamaterials, Digital Metamaterials and Programmable Metamaterials},
  author = {Cui, Tie Jun and Qi, Mei Qing and Wan, Xiang and Zhao, Jie and Cheng, Qiang},
  year = {2014},
  month = oct,
  journal = {Light Sci Appl},
