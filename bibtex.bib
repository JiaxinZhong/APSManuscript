@article{Dmochowski2009SpatialAliasingMicrophone,
  title = {On {{Spatial Aliasing}} in {{Microphone Arrays}}},
  author = {Dmochowski, Jacek and Benesty, Jacob and Affes, Sofi{\`E}ne},
