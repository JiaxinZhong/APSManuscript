@article{Joseph1994StatisticalAspectsActive,
  title = {Statistical {{Aspects}} of {{Active Control}} in {{Harmonic Enclosed Sound Fields}}},
  author = {Joseph, P. and Elliott, S. J. and Nelson, P. A.},
  year = {1994},
