@misc{Halder2025ControlledProbingLocalization,
  title = {Controlled Probing of Localization Effects in Non-{{Hermitian Aubry-Andr{\'e}}} Model via Topolectrical Circuits},
  author = {Halder, Dipendu and Basu, Saurabh},
