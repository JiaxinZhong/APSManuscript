@article{Xu2025EigenPlaneWave,
  title = {An Eigen Plane Wave Expansion Method for Reconstructing Enclosed Sound Fields at Low Frequencies},
  author = {Xu, Jian and Jin, Boao and Zhang, Jin},
  year = {2025},
