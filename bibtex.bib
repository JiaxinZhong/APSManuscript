@article{Verburg2021AcoustoOpticalVolumetricSensing,
  title = {Acousto-{{Optical Volumetric Sensing}} of {{Acoustic Fields}}},
  author = {Verburg, Samuel A. and {Fernandez-Grande}, Efren},
  year = {2021},
  month = oct,
  journal = {Phys. Rev. Appl.},
  volume = {16},
