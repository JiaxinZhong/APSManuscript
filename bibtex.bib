  author = {Park, Jonghwa and Kang, Dong-hee and Chae, Heeyoung and Ghosh, Sujoy Kumar and Jeong, Changyoon and Park, Yoojeong and Cho, Seungse and Lee, Youngoh and Kim, Jinyoung and Ko, Yujung and Kim, Jae Joon and Ko, Hyunhyub},
