  langid = {english},
  keywords = {coupled mode theory,Coupled mode theory,Dielectric waveguides,Numerical simulation,Optical systems,review,Second harmonic generation,Waveguide modes},
  file = {C:\Users\MrJia\Zotero\storage\LKE3FGFS\Huang_1994_Coupled-mode theory for optical waveguides.pdf}
