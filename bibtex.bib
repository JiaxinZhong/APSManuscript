@article{Gai2022AcousticPropertiesHoneycomb,
  title = {Acoustic Properties of Honeycomb like Sandwich Acoustic Metamaterials},
  author = {Gai, Xiao-Ling and Guan, Xi-Wen and Cai, Ze-Nong and Li, Xian-Hui and Hu, Wen-Cheng and Xing, Tuo and Wang, Fang},
  year = {2022},
