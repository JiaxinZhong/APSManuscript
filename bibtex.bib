@misc{Janssen2015Generalized3DZernike,
  title = {Generalized {{3D Zernike}} Functions for Analytic Construction of Band-Limited Line-Detecting Wavelets},
  author = {Janssen, Augustus J. E. M.},
  year = {2015},
  month = oct,
  number = {arXiv:1510.04837},
  eprint = {1510.04837},
