@article{Altland1997NonstandardSymmetryClasses,
  title = {Nonstandard Symmetry Classes in Mesoscopic Normal-Superconducting Hybrid Structures},
  author = {Altland, Alexander and Zirnbauer, Martin R.},
  year = {1997},
