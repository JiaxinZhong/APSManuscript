@article{Quan2021OddWillisCoupling,
  title = {Odd {{Willis}} Coupling Induced by Broken Time-Reversal Symmetry},
  author = {Quan, Li and Yves, Simon and Peng, Yugui and Esfahlani, Hussein and Al{\`u}, Andrea},
  year = {2021},
