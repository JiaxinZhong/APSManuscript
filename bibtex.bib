@article{LiuHolographicTensorMetasurface,
  title = {Holographic {{Tensor Metasurface}} for {{Simultaneous Wireless Powers}} and {{Information Transmissions Using Polarization Diversity}}},
  author = {Liu, Hai Xia and Li, Yi Cen and Cheng, Fang Jie and Wang, Xin and Chang, Ming Yang and Xue, Hao and Zhang, Song and Han, Jia Qi and Li, Guan Xuan and Li, Long and Cui, Tie Jun},
  journal = {Advanced Functional Materials},
