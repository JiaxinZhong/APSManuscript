@article{Chen2022ObservationTopologicalOrbital,
  title = {Observation of {{Topological}} \$p\$-{{Orbital Disclination States}} in {{Non-Euclidean Acoustic Metamaterials}}},
  author = {Chen, Ying and Yin, Yuhang and Lin, Zhi-Kang and Zheng, Ze-Huan and Liu, Yang and Li, Jing and Jiang, Jian-Hua and Chen, Huanyang},
