@article{Burrascano2020SweptSinePulseCompression,
  title = {A {{Swept-Sine Pulse Compression Procedure}} for an {{Effective Measurement}} of {{Intermodulation Distortion}}},
  author = {Burrascano, Pietro and Laureti, Stefano and Ricci, Marco and Terenzi, Alessandro and Cecchi, Stefania and Spinsante, Susanna and Piazza, Francesco},
  year = {2020},
