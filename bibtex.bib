@article{Huang2022GeneralFrameworkBound,
  title = {General {{Framework}} of {{Bound States}} in the {{Continuum}} in an {{Open Acoustic Resonator}}},
  author = {Huang, Lujun and Jia, Bin and Pilipchuk, Artem S. and Chiang, Yankei and Huang, Sibo and Li, Junfei and Shen, Chen and Bulgakov, Evgeny N. and Deng, Fu and Powell, David A. and Cummer, Steven A. and Li, Yong and Sadreev, Almas F. and Miroshnichenko, Andrey E.},
