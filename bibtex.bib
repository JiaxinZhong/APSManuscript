  author = {Nassar, Hussein and Yousefzadeh, Behrooz and Fleury, Romain and Ruzzene, Massimo and Al{\`u}, Andrea and Daraio, Chiara and Norris, Andrew N. and Huang, Guoliang and Haberman, Michael R.},
  year = {2020},
