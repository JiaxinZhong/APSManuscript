@article{Mousa2024ParallelMechanicalComputing,
  title = {Parallel Mechanical Computing: {{Metamaterials}} That Can Multitask},
  shorttitle = {Parallel Mechanical Computing},
  author = {Mousa, Mohamed and Nouh, Mostafa},
