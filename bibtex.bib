@article{Ge2023TunableBifunctionalAcoustic,
  title = {Tunable Bifunctional Acoustic Logic Gates Based on Topological Valley Transport},
  author = {Ge, Yong and Shi, Binjie and Jia, Ding and Sun, Hong-xiang and Xue, Haoran and Yuan, Shou-qi and Zhang, Baile},
  year = {2023},
