@article{Moller2019InfluenceTransferFunction,
  title = {On the {{Influence}} of {{Transfer Function Noise}} on {{Sound Zone Control}} in a {{Room}}},
  author = {M{\o}ller, Martin Bo and Nielsen, Jesper Kj{\ae}r and {Fernandez-Grande}, Efren and Olesen, S{\o}ren Krarup},
  year = {2019},
  month = sep,
  journal = {IEEE/ACM Transactions on Audio, Speech, and Language Processing},
  volume = {27},
  number = {9},
