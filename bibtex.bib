@article{Helbig2020GeneralizedBulkBoundary,
  title = {Generalized Bulk--Boundary Correspondence in Non-{{Hermitian}} Topolectrical Circuits},
  author = {Helbig, T. and Hofmann, T. and Imhof, S. and Abdelghany, M. and Kiessling, T. and Molenkamp, L. W. and Lee, C. H. and Szameit, A. and Greiter, M. and Thomale, R.},
  year = {2020},
