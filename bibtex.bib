  primaryclass = {cond-mat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2503.10359},
  urldate = {2025-03-18},
  abstract = {In this study, we systematically explore the non-Hermitian skin effect (NHSE) and its associated complex-frequency detection in the context of a frequency-dependent non-Hermitian Hamiltonian. This Hamiltonian arises from the self-energy correction of the subsystem and can be calculated exactly within our theoretical model, without the need for non-Hermitian approximations. Additionally, complex frequency detection, which encompasses complex frequency excitation, synthesis, and fingerprint, enables us to detect the physical responses driven by complex frequency excitations. Our calculations reveal that both complex frequency excitation and synthesis are sensitive to the non-Hermitian approximation and are unable to characterize the presence or abscence of the NHSE. In contrast, the complex-frequency fingerprint successfully detects the novel responses induced by the NHSE through the introduction of a double-frequency Green's function. Our work paves the way for a rigorous understanding of non-Hermitian physics in quantum systems and their experimental verification through complex frequency-domain techniques.},
  archiveprefix = {arXiv},
  keywords = {Condensed Matter - Mesoscale and Nanoscale Physics,Physics - Optics,Quantum Physics},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\X7XTAR3J\\Huang 等 - 2025 - Complex Frequency Detection in a Subsystem.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\CSSNINJ5\\2503.html}
}

@misc{Huang2025StabilizationDestabilizationMultimode,
