@article{Tyurina2022SpectralModelingDifferenceFrequency,
  title = {Spectral {{Modeling}} of {{Difference-Frequency Generation}} in the {{Case}} of {{Two-Frequency Interaction}} of {{Ultrasound Waves}}},
  author = {Tyurina, A. V. and Yuldashev, P. V. and Esipov, I. B. and Khokhlova, V. A.},
