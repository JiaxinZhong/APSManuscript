  author = {Xie, Guodong and Ren, Yongxiong and Huang, Hao and Lavery, Martin P. J. and Ahmed, Nisar and Yan, Yan and Bao, Changjing and Li, Long and Zhao, Zhe and Cao, Yinwen and Willner, Moshe and Tur, Moshe and Dolinar, Samuel J. and Boyd, Robert W. and Shapiro, Jeffrey H. and Willner, Alan E.},
  year = {2015},
