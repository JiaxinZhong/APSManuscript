@misc{Cheng2023ThreedimensionalFlatLandau,
  title = {Three-Dimensional Flat {{Landau}} Levels in an Inhomogeneous Acoustic Crystal},
  author = {Cheng, Zheyu and Guan, Yi-jun and Xue, Haoran and Ge, Yong and Jia, Ding and Long, Yang and Yuan, Shou-qi and Sun, Hong-xiang and Chong, Yidong and Zhang, Baile},
  year = {2023},
