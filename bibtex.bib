@article{Prawda2022CalibratingSabineEyring,
  title = {Calibrating the {{Sabine}} and {{Eyring}} Formulas},
  author = {Prawda, Karolina and Schlecht, Sebastian J. and V{\"a}lim{\"a}ki, Vesa},
  year = {2022},
  month = aug,
  journal = {The Journal of the Acoustical Society of America},
  volume = {152},
  number = {2},
