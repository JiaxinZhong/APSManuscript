  primaryclass = {physics},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2306.15361},
  urldate = {2024-03-15},
  abstract = {The design of devices based on acoustic or optical fields requires the fabrication of cavities and structures capable of efficiently trapping these waves. A special type of cavity can be designed to support resonances with a theoretically infinite quality factor, named bound states in the continuum or BICs. The experimental measurement of such modes is still a challenging problem, as they are, by definition, not accessible from external perturbations. Therefore, current reported works rely on indirect measurements that are based on the traces left by these modes on external properties of one-dimensional systems. Here we report on the theoretical design and experimental realization of a two-dimensional, fully open acoustic resonator supporting BICs. This BIC, whose symmetry is chosen during design by properly tailoring the geometrical properties of the system, is completely accessible and allows for the direct measurement of the whole pressure field and properties. We experimentally demonstrate its existence with high quality factor and field enhancement properties.},
  archiveprefix = {arXiv},
  keywords = {Physics - Applied Physics,Physics - Classical Physics},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\WWCXUB2S\\Martí-Sabaté et al_2023_Observation of Two-Dimensional Acoustic Bound States in the Continuum.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\WRF88EVI\\2306.html}
}

