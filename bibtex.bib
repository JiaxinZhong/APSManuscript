@article{Zhang2024GHzLithiumNiobate,
  title = {Near {{GHz Lithium Niobate Higher-Order Topological Nanomechanical Metamaterials}}},
  author = {Zhang, Zi-Dong and Yu, Si-Yuan and Lu, Ming-Hui and Chen, Yan-Feng},
