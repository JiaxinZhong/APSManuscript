@inproceedings{Thomas2014MethodConvertingCylindrical,
  title = {A Method for Converting between Cylindrical and Spherical Harmonic Representations of Sound Fields},
  booktitle = {2014 {{IEEE International Conference}} on {{Acoustics}}, {{Speech}} and {{Signal Processing}} ({{ICASSP}})},
