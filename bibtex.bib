  urldate = {2025-08-01},
  abstract = {Achieving efficient and crosstalk-free connections between components is crucial in analog devices. The recent development of topological materials within condensed matter physics has underscored their considerable potential as infrastructure for phononic and photonic analog signal processing. This is attributed to their capacity to facilitate a high degree of freedom, broadband, dispersion-free, and antireflective mechanical and electromagnetic wave transmission. The merits of this transmission warrant further exploration and extension into the domain of component connections. Here, we introduce and validate an ideal connector, termed a topological metataper, harnessing solid-state phononic crystal plates. By employing an adiabatic assembly of topological insulator interfaces with varying skin depths, the metataper sustains all the beneficial attributes of topological materials, thus enabling lossless transmission aperture switching on demand, presenting an ideal solution for connecting phononic and photonic components of varying sizes in series or parallel. This metataper also lights up as an exemplary beam-shaping technique, adept at transforming diverse incidences into coherent plane-wave emissions with predefined apertures and energy profiles. This study broadens the application of topological materials beyond waveguides, laying the groundwork for multifunctional and efficient topological photonic and phononic chips for future information processing, sensing, manipulating, and energy harvesting.},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\Q3XUYP7T\\Chen et al. - 2025 - Topological adiabatic metatapering and beam shaping in solid-state phononic metamaterials.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\LBBUQFDM\\PhysRevApplied.23.html}
