@article{Hossain2024HybridTopologicalQuantum,
  title = {A Hybrid Topological Quantum State in an Elemental Solid},
  author = {Hossain, Md Shafayat and Schindler, Frank and Islam, Rajibul and Muhammad, Zahir and Jiang, Yu-Xiao and Cheng, Zi-Jia and Zhang, Qi and Hou, Tao and Chen, Hongyu and Litskevich, Maksim and Casas, Brian and Yin, Jia-Xin and Cochran, Tyler A. and Yahyavi, Mohammad and Yang, Xian P. and Balicas, Luis and Chang, Guoqing and Zhao, Weisheng and Neupert, Titus and Hasan, M. Zahid},
  year = {2024},
