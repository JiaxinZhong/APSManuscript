@article{Jia2025SynthesizedAcousticVortexFrequency,
  title = {Synthesized {{Acoustic Vortex-Frequency Comb}} via {{Rotational Doppler Effect}}},
  author = {Jia, Yurou and Zhang, Xuan and Zhang, Suying and Xu, Guoqiang and Chen, Taoyu and Zhou, Hongtao and Bai, Yechao and Cheng, Ying and Wu, Dajian and Liu, Xiaojun and Qiu, Cheng-Wei},
