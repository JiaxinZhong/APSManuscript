  langid = {english},
  keywords = {Electrical and electronic engineering,NEMS},
  file = {C:\Users\MrJia\Zotero\storage\QBEUB4K5\Ji et al. - 2025 - Synthetic-domain computing and neural networks using lithium niobate integrated nonlinear phononics.pdf}
}

@article{Jia2019ObservationChiralZero,
  title = {Observation of Chiral Zero Mode in Inhomogeneous Three-Dimensional {{Weyl}} Metamaterials},
  author = {Jia, Hongwei and Zhang, Ruixing and Gao, Wenlong and Guo, Qinghua and Yang, Biao and Hu, Jing and Bi, Yangang and Xiang, Yuanjiang and Liu, Chaoxing and Zhang, Shuang},
