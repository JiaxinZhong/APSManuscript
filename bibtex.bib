  title = {Large-Chiral-Number Corner Modes in \${\textbackslash}mathbb\{\vphantom\}{{Z}}\vphantom\{\}\$-Class Higher-Order Topolectrical Circuits},
  author = {Li, Yi and Zhang, Jia-Hui and Mei, Feng and Xie, Biye and Lu, Ming-Hui and Ma, Jie and Xiao, Liantuan and Jia, Suotang},
  year = {2023},
  month = dec,
  journal = {Phys. Rev. Appl.},
  volume = {20},
