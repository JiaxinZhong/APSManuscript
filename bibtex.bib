}

@article{Kim2023LossCompensationSuperresolution,
  title = {Loss {{Compensation}} and {{Superresolution}} in {{Metamaterials}} with {{Excitations}} at {{Complex Frequencies}}},
  author = {Kim, Seunghwi and Peng, Yu-Gui and Yves, Simon and Al{\`u}, Andrea},
  year = {2023},
