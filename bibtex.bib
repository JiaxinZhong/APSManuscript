@article{Shaibe2025SuperuniversalStatisticsComplex,
  title = {Superuniversal {{Statistics}} of {{Complex Time Delays}} in {{Non-Hermitian Scattering Systems}}},
  author = {Shaibe, Nadav and Erb, Jared M. and Anlage, Steven M.},
  year = {2025},
  month = apr,
  journal = {Phys. Rev. Lett.},
  volume = {134},
  number = {14},
  pages = {147203},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevLett.134.147203},
  urldate = {2025-04-28},
  abstract = {The Wigner-Smith time delay of flux conserving systems is a real quantity that measures how long an excitation resides in an interaction region. The complex generalization of time delay to non-Hermitian systems is still under development, in particular, its statistical properties in the short-wavelength limit of complex chaotic scattering systems has not been investigated. From the experimentally measured multiport scattering ({$S$}) matrices of one-dimensional graphs, a two-dimensional billiard, and a three-dimensional cavity, we calculate the complex Wigner-Smith ({$T$}WS), as well as each individual reflection ({$Tx$}⁢{$x$}) and transmission ({$Tx$}⁢{$y$}) time delay. The complex reflection time-delay differences ({$T\delta$}⁢{$R$}) between each port are calculated, and the transmission time-delay differences ({$T\delta$}⁢{$T$}) are introduced for systems exhibiting nonreciprocal scattering. Large time delays are associated with scattering singularities such as coherent perfect absorption, reflectionless scattering, slow light, and unidirectional invisibility. We demonstrate that the large-delay tails of the distributions of the real and imaginary parts of each time-delay quantity are superuniversal, independent of experimental parameters: wave propagation dimension {$D$}, number of scattering channels {$M$}, Dyson symmetry class {$B$}, and uniform attenuation {$H$}. The tails determine the abundance of the singularities in generic scattering systems, and the superuniversality is in direct contrast with the well-established time-delay statistics of unitary scattering systems, where the tail of the {$T$}WS distribution depends explicitly on the values of {$M$} and {$B$}. We relate the distribution statistics to the topological properties of the corresponding singularities. Although the results presented here are based on classical microwave experiments, they are applicable to any non-Hermitian wave-chaotic scattering system in the short-wavelength limit, such as optical or acoustic resonators.},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\93RD8IWJ\\Shaibe 等 - 2025 - Superuniversal Statistics of Complex Time Delays in Non-Hermitian Scattering Systems.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\QZ3MK7P2\\PhysRevLett.134.html}
}

