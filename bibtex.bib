}

@article{He2024QuasiOneDimensionalSpinTransport,
  title = {Quasi-{{One-Dimensional Spin Transport}} in {{Altermagnetic}} \$\{\vphantom\}{{Z}}\vphantom\{\}{\textasciicircum}\{3\}\$ {{Nodal Net Metals}}},
  author = {He, Tingli and Li, Lei and Cui, Chaoxi and Zhang, Run-Wu and Yu, Zhi-Ming and Liu, Guodong and Zhang, Xiaoming},
  year = {2024},
  month = oct,
  journal = {Phys. Rev. Lett.},
  volume = {133},
  number = {14},
  pages = {146602},
