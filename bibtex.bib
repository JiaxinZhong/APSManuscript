@article{Santos2024HardwareAcceleratedActive,
  title = {Hardware Accelerated {{Active Noise Cancellation}} System Using {{Haar}} Wavelets},
  author = {Santos, P. and Mendes, E. and Carvalho, J. and Alves, F. and Azevedo, J. and Cabral, J.},
  year = {2024},
