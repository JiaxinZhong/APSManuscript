@article{Martins2023NonnegativeIntensityHeavy,
  title = {Non-Negative Intensity for a Heavy Fluid-Loaded Stiffened Plate},
  author = {Martins, Daniel and Karimi, Mahmoud and Maxit, Laurent and Kirby, Ray},
  year = {2023},
