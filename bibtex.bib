@article{Zhu2024HighresolutionSubbottomProfiling,
  title = {High-Resolution Sub-Bottom Profiling Technology Using Parametric Array and Vector Hydrophone},
  author = {Zhu, Jianjun and Zhou, Tian and Li, Tie and Chen, Baowei and Meng, Xinbao and Mazhar, Suleman},
