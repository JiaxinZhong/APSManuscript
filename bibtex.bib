  pages = {1057--1110},
  publisher = {American Physical Society},
  doi = {10.1103/RevModPhys.83.1057},
  urldate = {2022-11-22},
  abstract = {Topological insulators are new states of quantum matter which cannot be adiabatically connected to conventional insulators and semiconductors. They are characterized by a full insulating gap in the bulk and gapless edge or surface states which are protected by time-reversal symmetry. These topological materials have been theoretically predicted and experimentally observed in a variety of systems, including HgTe quantum wells, BiSb alloys, and Bi2Te3 and Bi2Se3 crystals. Theoretical models, materials properties, and experimental results on two-dimensional and three-dimensional topological insulators are reviewed, and both the topological band theory and the topological field theory are discussed. Topological superconductors have a full pairing gap in the bulk and gapless surface states consisting of Majorana fermions. The theory of topological superconductors is reviewed, in close analogy to the theory of topological insulators.},
  keywords = {review,topological insulator},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\FIBW4R6K\\Qi_Zhang_2011_Topological insulators and superconductors.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\59X3EBYB\\RevModPhys.83.html}
