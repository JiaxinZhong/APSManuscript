}

@article{Chen2024ObservationParitytimeSymmetry,
  title = {Observation of Parity-Time Symmetry for Evanescent Waves},
  author = {Chen, Zhaoxian and He, Huan and Li, Huanan and Li, Meijie and Kou, Jun-long and Lu, Yan-qing and Xu, Jingjun and Al{\`u}, Andrea},
  year = {2024},
  month = oct,
  journal = {Commun Phys},
