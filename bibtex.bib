@article{Karlinsky2022UltrasoundFrequencyMixing,
  title = {Ultrasound {{Frequency Mixing}} for {{Enhanced Contrast Harmonic Imaging}} of {{Microbubbles}}},
  author = {Karlinsky, Keren T. and Ilovitsh, Tali},
