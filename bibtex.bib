@article{Luo2015QuantumSimulation2D,
  title = {Quantum Simulation of {{2D}} Topological Physics in a {{1D}} Array of Optical Cavities},
  author = {Luo, Xi-Wang and Zhou, Xingxiang and Li, Chuan-Feng and Xu, Jin-Shi and Guo, Guang-Can and Zhou, Zheng-Wei},
  year = {2015},
