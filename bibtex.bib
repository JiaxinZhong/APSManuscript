}

@misc{Li2025PhasespaceGeneralizedBrillouin,
  title = {Phase-Space {{Generalized Brillouin Zone}} for Spatially Inhomogeneous Non-{{Hermitian}} Systems},
  author = {Li, Qingya and Jiang, Hui and Lee, Ching Hua},
  year = {2025},
