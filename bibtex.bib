@article{Juricic2024YukawaLorentzSymmetryNonHermitian,
  title = {Yukawa-{{Lorentz}} Symmetry in Non-{{Hermitian Dirac}} Materials},
  author = {Juri{\v c}i{\'c}, Vladimir and Roy, Bitan},
