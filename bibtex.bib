@article{Kim2023BatterylessImplantableDevice,
  title = {Batteryless Implantable Device with Built-in Mechanical Clock for Automated and Precisely Timed Drug Administration},
  author = {Kim, Min Ji and Kim, Cho Rim and Park, Chan Soon and Kang, Hyejeong and Cho, Ye Seul and Yeom, Da-Hae and Kim, Myoung Ju and Han, Jae Hoon and Ji, Han Bi and Cho, Yong Chan and Min, Chang Hee and Kim, Do Yeon and Lee, Ji Won and Lee, Cheol and Lee, Seung-Pyo and Choy, Young Bin},
  year = {2023},
