@article{Mo2022ImaginaryDisorderInducedTopologicalPhase,
  title = {Imaginary-{{Disorder-Induced Topological Phase Transitions}}},
  author = {Mo, Qingyang and Sun, Yeyang and Li, Junkai and Ruan, Zhichao and Yang, Zhaoju},
