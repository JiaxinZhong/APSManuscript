@article{Cervenka2022RoleResonanceThermoviscous,
  title = {On the Role of Resonance and Thermoviscous Losses in an Implementation of ``Acoustic Black Hole'' for Sound Absorption in Air},
  author = {{\v C}ervenka, M. and Bedna{\v r}{\'i}k, M.},
  year = {2022},
