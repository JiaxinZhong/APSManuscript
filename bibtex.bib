  author = {Kirsch, Marco S. and Zhang, Yiqi and Kremer, Mark and Maczewsky, Lukas J. and Ivanov, Sergey K. and Kartashov, Yaroslav V. and Torner, Lluis and Bauer, Dieter and Szameit, Alexander and Heinrich, Matthias},
