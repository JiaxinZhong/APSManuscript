@article{Zhong2023LocalnonlinearityenabledDeepSubdiffraction,
  title = {Local-Nonlinearity-Enabled Deep Subdiffraction Control of Acoustic Waves},
  author = {Zhong, Jiaxin and Hu, Chengbo and Wang, Kangkang and Ji, Jun and Zhuang, Tao and Zou, Haishan and Lu, Jing and Heo, Hyeonu and Liang, Bin and Jing, Yun and Cheng, Jian-Chun},
