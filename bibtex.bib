@article{Kim2022ParametricArrayLoudspeaker,
  title = {A Parametric Array Loudspeaker Featuring a {{Langevin}} Transducer, a Circular Aluminum Plate, and Composite Polymer Steps},
  author = {Kim, Chayeong and Hwang, Yonghwan and Shin, Kumjae and Moon, Wonkyu},
