  keywords = {Physics - Applied Physics},
  file = {C\:\\Users\\MrJia\\Zotero\\storage\\E3EDJ7Z5\\Zhu et al. - 2025 - Three-dimensional topological disclination in acoustic crystals.pdf;C\:\\Users\\MrJia\\Zotero\\storage\\NTLKCTHY\\2505.html}
}

