@article{Zhang2023MultiplePhaseTransitions,
  title = {Multiple Phase Transitions and Anomalous Non-{{Hermitian}} Skin Effect},
  author = {Zhang, Tian and Zhang, Xiujuan and Lu, Ming-Hui and Chen, Yan-Feng},
