@article{Todaro2020GrainStructureControl,
  title = {Grain Structure Control during Metal {{3D}} Printing by High-Intensity Ultrasound},
  author = {Todaro, C. J. and Easton, M. A. and Qiu, D. and Zhang, D. and Bermingham, M. J. and Lui, E. W. and Brandt, M. and StJohn, D. H. and Qian, M.},
  year = {2020},
